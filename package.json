{
  "name": "agent-opt",
  "version": "0.1.0",
  "description": "Optimize Claude Code, Codex, Cursor & Antigravity with smarter context, fewer tokens, faster coding and automatic verification.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tradertanmay/agent-opt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradertanmay/agent-opt.git"
  },
  "bugs": {
    "url": "https://github.com/tradertanmay/agent-opt/issues"
  },
  "type": "module",
  "bin": {
    "aopt": "./dist/cli/index.js",
    "agent-opt": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tests/**",
    "!dist/benchmarks/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "benchmark": "npm run build && node dist/benchmarks/run-benchmarks.js",
    "demo": "npm run build && node dist/examples/demo-60s.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "claude-code-plugin",
    "openai-codex",
    "codex",
    "cursor",
    "cursor-ai",
    "google-antigravity",
    "agentic-ai",
    "llm",
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "context-engineering",
    "context-optimization",
    "token-optimization",
    "llm-optimization",
    "ai-coding",
    "agent-optimization",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
